# Copy to .env in the repo root and fill in real values. .env is gitignored
# — never commit real secrets here. Loaded automatically (src/grader/
# llm_config.py) by every local entrypoint: server/main.py, app.py,
# experiments/consistency_test.py, experiments/ablation.py.
#
# Only needed if you want the "openai" provider — the default ("local",
# llama-server) needs none of this. See README.md's "Switching to the
# OpenAI API" section and configs/model.yaml for the determinism caveat.

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Local-provider overrides (only used when LLM_PROVIDER=local / unset):
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M
